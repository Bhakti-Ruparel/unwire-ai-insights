# ─── Server ────────────────────────────────────────────────────────────────
PORT=5000

# ─── Public URL (REQUIRED for real VPS agent installation) ─────────────────
# This is the URL that remote servers will use to reach this backend.
# For tunnel testing: API_PUBLIC_URL="https://your-tunnel.ngrok-free.app"
# For production: API_PUBLIC_URL="https://api.unwire.ai"
# If not set, the installer will use the machine's LAN IP (only works on same network)
# API_PUBLIC_URL=""

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/unwire_ai?schema=public"

# ─── CORS ───────────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"

# ─── Auth ───────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-strong-secret-here"

# ─── Environment ────────────────────────────────────────────────────────────
NODE_ENV="development"
