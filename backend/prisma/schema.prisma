generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User ──────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  projects     Project[]

  @@map("users")
}

// ─── Project ───────────────────────────────────────────────────────────────

model Project {
  id             String        @id @default(uuid())
  name           String
  description    String        @default("")
  sourceType     String        @default("zip")   // "zip" | "github"
  githubUrl      String?
  status         String        @default("Queued") // "Analyzed" | "Analyzing" | "Queued" | "Error"
  analysisStatus String        @default("queued") // "idle" | "queued" | "processing" | "complete" | "failed"
  stack          String[]      @default([])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Optional owner — null means legacy/unauthenticated project
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Relations
  stats          ProjectStats?
  apis           APIEndpoint[]
  dependencies   Dependency[]
  backend        BackendInfo?
  schema         SchemaTable[]
  externalServices ExternalService[]

  @@map("projects")
}

// ─── Project Stats ─────────────────────────────────────────────────────────

model ProjectStats {
  id               String  @id @default(uuid())
  projectId        String  @unique
  filesCount       Int     @default(0)
  apiCount         Int     @default(0)
  dependencyCount  Int     @default(0)
  externalCount    Int     @default(0)
  schemaCount      Int     @default(0)

  project          Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_stats")
}

// ─── API Endpoint ──────────────────────────────────────────────────────────

model APIEndpoint {
  id            String   @id @default(uuid())
  projectId     String
  method        String                          // GET | POST | PUT | PATCH | DELETE
  path          String
  file          String   @default("")
  description   String   @default("")
  usage         Int      @default(0)
  authenticated Boolean  @default(false)
  middleware    String[] @default([])
  createdAt     DateTime @default(now())

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("api_endpoints")
}

// ─── Dependency ────────────────────────────────────────────────────────────

model Dependency {
  id        String  @id @default(uuid())
  projectId String
  name      String
  version   String  @default("")
  type      String  @default("runtime")         // "runtime" | "dev" | "peer"

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("dependencies")
}

// ─── External Service ──────────────────────────────────────────────────────

model ExternalService {
  id        String  @id @default(uuid())
  projectId String
  name      String
  type      String  @default("other")           // "payment" | "ai" | "cloud" | "email" | "sms" | "auth" | "storage" | "database" | "monitoring" | "other"
  usage     Int     @default(0)
  file      String  @default("")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("external_services")
}

// ─── Backend Info ──────────────────────────────────────────────────────────

model BackendInfo {
  id           String   @id @default(uuid())
  projectId    String   @unique
  framework    String   @default("")
  routes       Int      @default(0)
  controllers  Int      @default(0)
  middleware   String[] @default([])
  requestFlow  String   @default("")

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("backend_info")
}

// ─── Schema Table ──────────────────────────────────────────────────────────

model SchemaTable {
  id        String   @id @default(uuid())
  projectId String
  tableName String
  fields    String[] @default([])

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("schema_tables")
}
