generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User ──────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String   @default("")
  role         String   @default("USER")      // "USER" | "ADMIN"
  isActive     Boolean  @default(true)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  projects         Project[]
  servers          Server[]
  sessions         Session[]
  orgMemberships   OrganizationMember[]
  ownedOrgs        Organization[]
  usageRecords     UsageRecord[]
  deployments      Deployment[]
  alerts           Alert[]
  incidents        Incident[]
  notifications    Notification[]

  @@index([email])
  @@index([role])
  @@map("users")
}

// ─── Session (refresh token store) ────────────────────────────────────────

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  userAgent    String   @default("")
  ipAddress    String   @default("")
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("sessions")
}

// ─── Organization ──────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  ownerId   String
  plan      String   @default("free")     // "free"|"pro"|"enterprise"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User               @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  members   OrganizationMember[]
  projects  Project[]
  servers   Server[]
  subscription Subscription?
  invitations  Invitation[]
  apiKeys      ApiKey[]
  infraConnections InfraConnection[]

  @@index([ownerId])
  @@map("organizations")
}

// ─── Organization Member ───────────────────────────────────────────────────

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           String       @default("MEMBER")  // "OWNER"|"ADMIN"|"MEMBER"
  joinedAt       DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

// ─── Usage Record ──────────────────────────────────────────────────────────

model UsageRecord {
  id        String   @id @default(uuid())
  userId    String
  type      String                          // "ai_message"|"embedding"|"upload"|"api_request"
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, createdAt])
  @@map("usage_records")
}

// ─── Project ───────────────────────────────────────────────────────────────

model Project {
  id              String  @id @default(uuid())
  name            String
  description     String  @default("")
  sourceType      String  @default("zip")
  githubUrl       String?
  status          String  @default("Queued")
  analysisStatus  String  @default("queued")
  stack           String[] @default([])
  embeddingStatus String  @default("not_started")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  stats              ProjectStats?
  apis               APIEndpoint[]
  dependencies       Dependency[]
  backend            BackendInfo?
  schema             SchemaTable[]
  externalServices   ExternalService[]
  chatSessions       ChatSession[]
  deploymentAnalysis DeploymentAnalysis?
  deployments        Deployment[]

  @@index([userId])
  @@index([organizationId])
  @@map("projects")
}

// ─── Project Stats ─────────────────────────────────────────────────────────

model ProjectStats {
  id              String  @id @default(uuid())
  projectId       String  @unique
  filesCount      Int     @default(0)
  apiCount        Int     @default(0)
  dependencyCount Int     @default(0)
  externalCount   Int     @default(0)
  schemaCount     Int     @default(0)

  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_stats")
}

// ─── API Endpoint ──────────────────────────────────────────────────────────

model APIEndpoint {
  id            String   @id @default(uuid())
  projectId     String
  method        String
  path          String
  file          String   @default("")
  description   String   @default("")
  usage         Int      @default(0)
  authenticated Boolean  @default(false)
  middleware    String[] @default([])
  createdAt     DateTime @default(now())

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("api_endpoints")
}

// ─── Dependency ────────────────────────────────────────────────────────────

model Dependency {
  id        String  @id @default(uuid())
  projectId String
  name      String
  version   String  @default("")
  type      String  @default("runtime")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("dependencies")
}

// ─── External Service ──────────────────────────────────────────────────────

model ExternalService {
  id        String  @id @default(uuid())
  projectId String
  name      String
  type      String  @default("other")
  usage     Int     @default(0)
  file      String  @default("")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("external_services")
}

// ─── Backend Info ──────────────────────────────────────────────────────────

model BackendInfo {
  id          String  @id @default(uuid())
  projectId   String  @unique
  framework   String  @default("")
  routes      Int     @default(0)
  controllers Int     @default(0)
  middleware  String[] @default([])
  requestFlow String  @default("")

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("backend_info")
}

// ─── Schema Table ──────────────────────────────────────────────────────────

model SchemaTable {
  id        String   @id @default(uuid())
  projectId String
  tableName String
  fields    String[] @default([])

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("schema_tables")
}

// ─── Chat Session ──────────────────────────────────────────────────────────

model ChatSession {
  id        String      @id @default(uuid())
  projectId String
  createdAt DateTime    @default(now())

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@map("chat_sessions")
}

// ─── Chat Message ──────────────────────────────────────────────────────────

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime    @default(now())

  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

// ─── Deployment Analysis ───────────────────────────────────────────────────

model DeploymentAnalysis {
  id                String  @id @default(uuid())
  projectId         String  @unique
  status            String  @default("pending")
  score             Int     @default(0)
  filesDetected     Json    @default("[]")
  scoreBreakdown    Json    @default("{}")
  architectureNodes Json    @default("[]")
  architectureEdges Json    @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues          DeploymentIssue[]
  recommendations DeploymentRec[]

  @@index([projectId])
  @@map("deployment_analyses")
}

// ─── Deployment Issue ──────────────────────────────────────────────────────

model DeploymentIssue {
  id         String             @id @default(uuid())
  analysisId String
  severity   String
  category   String
  message    String
  file       String             @default("")
  line       Int?
  suggestion String             @default("")
  createdAt  DateTime           @default(now())

  analysis   DeploymentAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@map("deployment_issues")
}

// ─── Deployment Recommendation ────────────────────────────────────────────

model DeploymentRec {
  id          String             @id @default(uuid())
  analysisId  String
  priority    Int                @default(0)
  title       String
  description String
  category    String
  codeSnippet String             @default("")
  createdAt   DateTime           @default(now())

  analysis    DeploymentAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@map("deployment_recs")
}

// ─── Server ────────────────────────────────────────────────────────────────

model Server {
  id             String  @id @default(uuid())
  userId         String?
  organizationId String?
  name           String
  host           String
  provider       String  @default("custom")
  region         String  @default("")
  status         String  @default("unknown")
  sshUser        String  @default("root")
  sshPort        Int     @default(22)
  agentToken     String  @unique                 // used by agent for push auth
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  metrics      ServerMetric[]
  heartbeats   ServerHeartbeat[]
  applications ServerApp[]
  logs         ServerLog[]
  domains      ServerDomain[]
  sslCerts     SslCert[]
  deployments  Deployment[]

  @@index([userId])
  @@index([organizationId])
  @@map("servers")
}

// ─── Server Metric ────────────────────────────────────────────────────────

model ServerMetric {
  id          String   @id @default(uuid())
  serverId    String
  cpuPercent  Float    @default(0)
  ramPercent  Float    @default(0)
  diskPercent Float    @default(0)
  networkIn   Float    @default(0)
  networkOut  Float    @default(0)
  cpuUsage    Float    @default(0)
  cpuCores    Int      @default(0)
  loadAverage Float[]  @default([])
  memoryTotal Float    @default(0)
  memoryUsed  Float    @default(0)
  memoryFree  Float    @default(0)
  diskTotal   Float    @default(0)
  diskUsed    Float    @default(0)
  recordedAt  DateTime @default(now())

  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, recordedAt])
  @@map("server_metrics")
}

model ServerHeartbeat {
  id           String   @id @default(uuid())
  serverId     String
  status       String   @default("online")
  agentVersion String   @default("")
  ip           String   @default("")
  timestamp    DateTime @default(now())

  server       Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, timestamp])
  @@map("server_heartbeats")
}

// ─── Server Application ───────────────────────────────────────────────────

model ServerApp {
  id         String   @id @default(uuid())
  serverId   String
  name       String
  type       String   @default("node")
  status     String   @default("stopped")
  port       Int?
  pid        Int?
  uptime     String   @default("")
  memory     Float    @default(0)
  cpu        Float    @default(0)
  lastAction String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  server     Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@map("server_apps")
}

// ─── Server Log ──────────────────────────────────────────────────────────

model ServerLog {
  id        String   @id @default(uuid())
  serverId  String
  appName   String   @default("")
  level     String   @default("info")
  message   String
  timestamp DateTime @default(now())

  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, timestamp])
  @@index([serverId, appName])
  @@index([serverId, level, timestamp])
  @@map("server_logs")
}

// ─── Server Domain ───────────────────────────────────────────────────────

model ServerDomain {
  id        String   @id @default(uuid())
  serverId  String
  domain    String
  type      String   @default("A")
  target    String
  status    String   @default("active")
  createdAt DateTime @default(now())

  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@map("server_domains")
}

// ─── SSL Certificate ─────────────────────────────────────────────────────

model SslCert {
  id        String   @id @default(uuid())
  serverId  String
  domain    String
  provider  String   @default("letsencrypt")
  status    String   @default("pending")
  expiresAt DateTime?
  autoRenew Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@map("ssl_certs")
}

// ─── Deployment Execution (Phase 6) ───────────────────────────────────────

model Deployment {
  id            String    @id @default(uuid())
  projectId     String
  serverId      String
  userId        String
  version       Int       @default(1)          // auto-increment per project
  status        String    @default("QUEUED")   // QUEUED|RUNNING|SUCCESS|FAILED|ROLLED_BACK
  progress      Int       @default(0)          // 0–100
  plan          Json      @default("{}")        // DeploymentPlan from planner
  generatedFiles Json     @default("{}")        // Dockerfile, docker-compose, nginx, .env.example
  commitSha     String    @default("")
  branch        String    @default("main")
  environment   String    @default("production")
  error         String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  server  Server   @relation(fields: [serverId],  references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId],    references: [id], onDelete: Cascade)

  steps DeploymentStep[]
  logs  DeploymentLog[]

  @@index([projectId, createdAt])
  @@index([serverId,  createdAt])
  @@index([userId,    createdAt])
  @@index([status])
  @@map("deployments")
}

// ─── Deployment Step ──────────────────────────────────────────────────────

model DeploymentStep {
  id           String    @id @default(uuid())
  deploymentId String
  name         String
  status       String    @default("pending")  // pending|running|success|failed|skipped
  order        Int       @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  durationMs   Int?
  error        String?

  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId, order])
  @@map("deployment_steps")
}

// ─── Deployment Log (append-only, cursor-paginated) ───────────────────────

model DeploymentLog {
  id           String   @id @default(uuid())
  deploymentId String
  level        String   @default("info")   // info|warn|error|debug
  message      String
  stepName     String   @default("")
  timestamp    DateTime @default(now())

  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId, timestamp])
  @@map("deployment_logs")
}

// ─── Phase 9: Alert ───────────────────────────────────────────────────────

model Alert {
  id             String    @id @default(uuid())
  userId         String
  organizationId String?
  serverId       String?
  projectId      String?
  type           String                          // "cpu_high"|"ram_high"|"disk_high"|"app_crash"|"deploy_failed"|"server_offline"|"error_spike"
  severity       String    @default("WARNING")   // "INFO"|"WARNING"|"CRITICAL"
  title          String
  message        String
  recommendation String    @default("")
  status         String    @default("ACTIVE")    // "ACTIVE"|"ACKNOWLEDGED"|"RESOLVED"
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([serverId, createdAt])
  @@index([severity, status])
  @@map("alerts")
}

// ─── Phase 9: Incident ────────────────────────────────────────────────────

model Incident {
  id             String    @id @default(uuid())
  userId         String
  organizationId String?
  serverId       String?
  projectId      String?
  title          String
  description    String
  severity       String    @default("WARNING")   // "INFO"|"WARNING"|"CRITICAL"
  status         String    @default("OPEN")      // "OPEN"|"INVESTIGATING"|"RESOLVED"|"DISMISSED"
  rootCause      String?
  resolution     String?
  aiAnalysis     Json      @default("{}")         // DevOpsAnalysis from reasoner
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([serverId, status])
  @@index([severity, status])
  @@map("incidents")
}

// ─── Phase 9: Notification ────────────────────────────────────────────────

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String                             // "alert"|"incident"|"deployment"|"system"
  title     String
  message   String
  channel   String    @default("in_app")       // "in_app"|"email"|"slack"|"webhook"
  read      Boolean   @default(false)
  metadata  Json      @default("{}")
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ─── Phase 10: Subscription ───────────────────────────────────────────────

model Subscription {
  id                    String    @id @default(uuid())
  organizationId        String    @unique
  plan                  String    @default("free")
  status                String    @default("active")
  startDate             DateTime  @default(now())
  endDate               DateTime?
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  metadata              Json      @default("{}")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@map("subscriptions")
}

// ─── Phase 10: Invitation ─────────────────────────────────────────────────

model Invitation {
  id             String    @id @default(uuid())
  organizationId String
  email          String
  role           String    @default("DEVELOPER")
  status         String    @default("PENDING")
  invitedBy      String
  token          String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([token])
  @@map("invitations")
}

// ─── Phase 10: Audit Log ──────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String
  action         String
  resource       String   @default("")
  description    String   @default("")
  metadata       Json     @default("{}")
  ipAddress      String   @default("")
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

// ─── Phase 10: API Key ────────────────────────────────────────────────────

model ApiKey {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  hashedKey      String    @unique
  prefix         String
  permissions    String[]  @default(["read"])
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdBy      String
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([hashedKey])
  @@index([prefix])
  @@map("api_keys")
}

// ─── Multi-Cloud: Infrastructure Connection ───────────────────────────────

model InfraConnection {
  id             String    @id @default(uuid())
  organizationId String
  provider       String                            // "aws"|"digitalocean"|"azure"|"gcp"|"hetzner"|"docker"
  name           String                            // User-friendly name e.g. "Production AWS"
  status         String    @default("pending")     // "pending"|"connected"|"error"|"disconnected"
  region         String    @default("")            // Primary region or empty
  encryptedCreds String    @default("")            // AES-256 encrypted credentials JSON
  lastSyncAt     DateTime?
  lastError      String?
  metadata       Json      @default("{}")          // Provider-specific non-secret config
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resources      CloudResource[]

  @@index([organizationId])
  @@index([provider])
  @@map("infra_connections")
}

// ─── Multi-Cloud: Discovered Resource ─────────────────────────────────────

model CloudResource {
  id             String    @id @default(uuid())
  connectionId   String
  provider       String                            // Denormalized for fast queries
  resourceType   String                            // "instance"|"container"|"database"|"load_balancer"|"volume"
  resourceId     String                            // Provider-specific ID (e.g. i-0abc123, droplet-123)
  name           String
  region         String    @default("")
  status         String    @default("unknown")     // "running"|"stopped"|"terminated"|"unknown"
  specs          Json      @default("{}")          // { cpu, memory, disk, instanceType, etc. }
  metrics        Json      @default("{}")          // Latest metrics snapshot
  tags           Json      @default("[]")          // Provider tags/labels
  lastSeenAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  connection     InfraConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, resourceId])
  @@index([connectionId])
  @@index([provider, resourceType])
  @@index([status])
  @@map("cloud_resources")
}
